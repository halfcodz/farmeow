; Engine configuration file.
config_version=5

[application]

config/name="Meowmory"
config/description="보리와 잊힘의 숲 — 기억을 잃은 고양이의 여정 (데모)"
config/version="0.1.0-demo"
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.03, 0.04, 0.08, 1)
boot_splash/show_image=false
config/icon="res://icon.png"

[autoload]

Art="*res://scripts/autoload/art.gd"
Settings="*res://scripts/autoload/settings.gd"
Sound="*res://scripts/autoload/sound.gd"
Game="*res://scripts/autoload/game.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[physics]

common/physics_ticks_per_second=120
2d/default_gravity=900.0

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=false
2d/snap/snap_2d_vertices_to_pixel=false
environment/defaults/default_clear_color=Color(0.03, 0.04, 0.08, 1)
